# Variables de entorno necesarias para btiq.mx
# IMPORTANTE: copiar este archivo como .env.local y llenar los valores reales.
# NUNCA hacer commit de .env.local — agregarlo al .gitignore.

# Formspree — endpoint del formulario de contacto
# Obtener desde: https://formspree.io/forms (forma ya creada para btiq)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# Google Analytics 4 — Measurement ID
# Obtener desde: GA4 Admin → Flujos de datos → btiq.mx
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Site URL (usado para metadata canonical, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://btiq.mx

# HubSpot — GUID del formulario para enviar los leads al CRM (Forms API).
# NO necesita token secreto. Crear un formulario gratis en:
#   HubSpot → Marketing → Formularios → Crear formulario
# con los campos: First name, Last name, Email, Company name, Phone number,
# Message. Luego copiar el GUID del formulario (Compartir → o de la URL del
# editor: .../forms/<PORTAL_ID>/editor/<FORM_GUID>/edit).
HUBSPOT_FORM_GUID=00000000-0000-0000-0000-000000000000

# HubSpot Portal ID (opcional; default 51657541). Se usa en el código de
# seguimiento y en la Forms API.
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=51657541
# HUBSPOT_PORTAL_ID=51657541
