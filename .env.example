# Variables de entorno necesarias para btiq.mx
# IMPORTANTE: copiar este archivo como .env.local y llenar los valores reales.
# NUNCA hacer commit de .env.local — agregarlo al .gitignore.

# Formspree — endpoint del formulario de contacto
# Obtener desde: https://formspree.io/forms (forma ya creada para btiq)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# Google Analytics 4 — Measurement ID
# Obtener desde: GA4 Admin → Flujos de datos → btiq.mx
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Site URL (usado para metadata canonical, OG, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://btiq.mx
